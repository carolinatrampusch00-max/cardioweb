# Copy these settings into the existing .env file and replace every placeholder.
# Never commit .env or publish the secret values.
CARDIO_AUTH_BASE_URL=https://your-domain.example/TCC

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.example/TCC/oauth.php?provider=google

# Apple Sign in requires a public HTTPS callback and a Services ID.
APPLE_CLIENT_ID=com.example.cardioweb
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=C:/secure/path/AuthKey_example.p8
APPLE_REDIRECT_URI=https://your-domain.example/TCC/oauth.php?provider=apple

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid
